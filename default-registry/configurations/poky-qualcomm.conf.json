{
    "description": "Radxa Yocto for Qualcomm devices, release 6.0 'wrynose'",
    "expires": "2030-05-31",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "2.18"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-arm": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-arm",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-lts-mixins": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-lts-mixins",
                "branch": "wrynose/linux-firmware",
                "rev": "wrynose/linux-firmware"
            }
        },
        "meta-qcom": {
            "git-remote": {
                "uri": "https://github.com/qualcomm-linux/meta-qcom",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-radxa": {
            "git-remote": {
                "uri": "https://github.com/radxa/meta-radxa",
                "branch": "main",
                "rev": "main"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-yocto/meta-poky",
                    "meta-arm/meta-arm",
                    "meta-arm/meta-arm-toolchain",
                    "meta-openembedded/meta-oe",
                    "meta-lts-mixins",
                    "meta-qcom",
                    "meta-radxa/meta-qualcomm"
                ],
                "setup-dir-name": "$distro-qualcomm",
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "name": "machine/radxa-dragon-q6a",
                                "description": "Radxa Dragon Q6A"
                            }
                        ]
                    },
                    "distro": {
                        "description": "Target distributions",
                        "options": [
                            {
                                "name": "distro/poky",
                                "description": "Yocto Project Reference Distro"
                            },
                            {
                                "name": "distro/poky-altcfg",
                                "description": "Poky alternative with systemd as init manager"
                            },
                            {
                                "name": "distro/poky-tiny",
                                "description": "Poky alternative optimized for size"
                            }
                        ]
                    }
                },
                "configurations": [
                    {
                        "name": "poky",
                        "description": "Radxa Yocto for Qualcomm devices"
                    },
                    {
                        "name": "poky-with-sstate",
                        "description": "Radxa Yocto for Qualcomm devices with internet sstate acceleration. Use with caution as it requires a completely robust local network with sufficient bandwidth.",
                        "oe-fragments": [
                            "core/yocto/sstate-mirror-cdn"
                        ]
                    }
                ]
            }
        ]
    },
    "version": "1.0"
}
