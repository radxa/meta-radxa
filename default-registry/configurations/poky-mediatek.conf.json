{
    "description": "Radxa Yocto for MediaTek devices, release 5.0 'scarthgap'",
    "expires": "2028-04-30",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "2.18"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-arm": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-arm",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-tensorflow": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-tensorflow",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-security": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-security",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-lts-mixins": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-lts-mixins",
                "branch": "scarthgap/rust",
                "rev": "scarthgap/rust"
            }
        },
        "meta-clang": {
            "git-remote": {
                "uri": "https://github.com/kraj/meta-clang",
                "branch": "scarthgap-clang20",
                "rev": "scarthgap-clang20"
            }
        },
        "meta-browser": {
            "git-remote": {
                "uri": "https://gitlab.collabora.com/mediatek/aiot/rity/meta-browser",
                "branch": "mediatek/scarthgap",
                "rev": "mediatek/scarthgap"
            }
        },
        "meta-asix": {
            "git-remote": {
                "uri": "https://gitlab.com/asix_official/ax88179_series/mtk_genio/yocto/rity/meta-asix",
                "branch": "main",
                "rev": "main"
            }
        },
        "meta-rity": {
            "git-remote": {
                "uri": "https://gitlab.com/mediatek/aiot/rity/meta-rity",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-mediatek-bsp": {
            "git-remote": {
                "uri": "https://gitlab.com/mediatek/aiot/rity/meta-mediatek-bsp",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-mediatek-tsn": {
            "git-remote": {
                "uri": "https://gitlab.com/mediatek/aiot/rity/meta-mediatek-tsn",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-mediatek-demo": {
            "git-remote": {
                "uri": "https://gitlab.com/mediatek/aiot/rity/meta-mediatek-demo",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-mediatek-bluedroid": {
            "git-remote": {
                "uri": "https://gitlab.com/mediatek/aiot/rity/meta-mediatek-bluedroid",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-nn": {
            "git-remote": {
                "uri": "https://gitlab.com/mediatek/aiot/rity/meta-nn",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-radxa": {
            "git-remote": {
                "uri": "https://github.com/radxa/meta-radxa",
                "branch": "main",
                "rev": "main"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "bb-layers": [
                    "meta-rity/meta",
                    "meta-rity/meta-poky",
                    "meta-rity/meta-yocto-bsp",
                    "meta-arm/meta-arm",
                    "meta-arm/meta-arm-toolchain",
                    "meta-clang",
                    "meta-mediatek-bsp",
                    "meta-mediatek-tsn",
                    "meta-mediatek-bluedroid",
                    "meta-mediatek-demo",
                    "meta-asix",
                    "meta-nn",
                    "meta-security",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-perl",
                    "meta-rity/meta",
                    "meta-rity/meta-rity-bringup",
                    "meta-rity/meta-rity-demo",
                    "meta-tensorflow",
                    "meta-lts-mixins",
                    "meta-browser/meta-chromium",
                    "meta-radxa/meta-mediatek"
                ],
                "setup-dir-name": "$distro-mediatek",
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "name": "machine/radxa-nio12b",
                                "description": "Radxa NIO 12B (UFS boot)"
                            },
                            {
                                "name": "machine/radxa-nio12b-sd",
                                "description": "Radxa NIO 12B (SD boot)"
                            },
                            {
                                "name": "machine/radxa-nio12b-norboot-ufs",
                                "description": "Radxa NIO 12B (NOR bootloader, UFS rootfs)"
                            }
                        ]
                    },
                    "distro": {
                        "description": "Target distributions",
                        "options": [
                            {
                                "name": "distro/poky",
                                "description": "Yocto Project Reference Distro"
                            },
                            {
                                "name": "distro/poky-altcfg",
                                "description": "Poky alternative with systemd as init manager"
                            },
                            {
                                "name": "distro/poky-tiny",
                                "description": "Poky alternative optimized for size"
                            }
                        ]
                    }
                },
                "configurations": [
                    {
                        "name": "poky",
                        "description": "Radxa Yocto for MediaTek devices"
                    },
                    {
                        "name": "poky-with-sstate",
                        "description": "Radxa Yocto for MediaTek devices with internet sstate acceleration. Use with caution as it requires a completely robust local network with sufficient bandwidth.",
                        "oe-fragments": [
                            "core/yocto/sstate-mirror-cdn"
                        ]
                    }
                ]
            }
        ]
    },
    "version": "1.0"
}
