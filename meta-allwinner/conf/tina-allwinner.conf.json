{
    "description": "Radxa Yocto for Allwinner devices, release 5.0 'scarthgap'",
    "expires": "2028-04-30",
    "sources": {
        "bitbake": {
            "git-remote": {
                "uri": "https://git.openembedded.org/bitbake",
                "branch": "2.18",
                "rev": "2.18"
            }
        },
        "openembedded-core": {
            "git-remote": {
                "uri": "https://git.openembedded.org/openembedded-core",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-yocto": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-yocto",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-openembedded": {
            "git-remote": {
                "uri": "https://git.openembedded.org/meta-openembedded",
                "branch": "scarthgap",
                "rev": "scarthgap"
            }
        },
        "meta-tina": {
            "git-remote": {
                "uri": "https://gitlab.com/tina5.0_aiot/product/tina/yocto/meta-tina",
                "branch": "product-aiot-stable",
                "rev": "product-aiot-stable"
            }
        },
        "meta-radxa": {
            "git-remote": {
                "uri": "https://github.com/radxa/meta-radxa",
                "branch": "main",
                "rev": "main"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-yocto/meta-yocto-bsp",
                    "meta-openembedded/meta-oe",
                    "meta-tina",
                    "meta-radxa/meta-scarthgap",
                    "meta-radxa/meta-allwinner"
                ],
                "setup-dir-name": "$distro-allwinner",
                "oe-fragments-one-of": {
                    "machine": {
                        "description": "Target machines",
                        "options": [
                            {
                                "name": "machine/radxa-cubie-a5e",
                                "description": "Radxa Cubie A5E"
                            }
                        ]
                    },
                    "distro": {
                        "description": "Target distributions",
                        "options": [
                            {
                                "name": "distro/tina-industry",
                                "description": "AW Tina-Yocto-Distro"
                            },
                            {
                                "name": "distro/tina-minimal",
                                "description": "AW Tina-Yocto-Distro"
                            },
                            {
                                "name": "distro/tina-robot",
                                "description": "AW Tina-Yocto-Distro"
                            }
                        ]
                    }
                },
                "configurations": [
                    {
                        "name": "tina",
                        "description": "Radxa Yocto for Allwinner devices"
                    }
                ]
            }
        ]
    },
    "version": "1.0"
}
